{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/sales.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/quote",
      "dest": "/api/sales.js"
    },
    {
      "src": "/api/checkout",
      "dest": "/api/sales.js"
    },
    {
      "src": "/api/webhook/stripe",
      "dest": "/api/sales.js"
    },
    {
      "src": "/api/sales/(.*)",
      "dest": "/api/sales.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/products",
      "dest": "/public/products.html"
    },
    {
      "src": "/auto-trader",
      "dest": "/public/auto-trader.html"
    },
    {
      "src": "/claim-bot",
      "dest": "/public/claim-bot.html"
    },
    {
      "src": "/claimer",
      "dest": "/public/claimer.html"
    },
    {
      "src": "/customer-portal",
      "dest": "/public/customer-portal.html"
    },
    {
      "src": "/features",
      "dest": "/public/features.html"
    },
    {
      "src": "/history",
      "dest": "/public/history.html"
    },
    {
      "src": "/marketplace",
      "dest": "/public/marketplace.html"
    },
    {
      "src": "/micro-dashboard",
      "dest": "/public/micro-dashboard.html"
    },
    {
      "src": "/micro-login",
      "dest": "/public/micro-login.html"
    },
    {
      "src": "/micro-signup",
      "dest": "/public/micro-signup.html"
    },
    {
      "src": "/micro-teller",
      "dest": "/public/micro-teller.html"
    },
    {
      "src": "/micro-trade",
      "dest": "/public/micro-trade.html"
    },
    {
      "src": "/mining-dashboard",
      "dest": "/public/mining-dashboard.html"
    },
    {
      "src": "/mining-stats",
      "dest": "/public/mining-stats.html"
    },
    {
      "src": "/mining",
      "dest": "/public/mining.html"
    },
    {
      "src": "/portfolio",
      "dest": "/public/portfolio.html"
    },
    {
      "src": "/poster",
      "dest": "/public/poster.html"
    },
    {
      "src": "/receipt-invest",
      "dest": "/public/receipt-invest.html"
    },
    {
      "src": "/referral",
      "dest": "/public/referral.html"
    },
    {
      "src": "/roundup",
      "dest": "/public/roundup.html"
    },
    {
      "src": "/share-banner",
      "dest": "/public/share-banner.html"
    },
    {
      "src": "/stock-trader",
      "dest": "/public/stock-trader.html"
    },
    {
      "src": "/store-dashboard",
      "dest": "/public/store-dashboard.html"
    },
    {
      "src": "/terms",
      "dest": "/public/terms.html"
    },
    {
      "src": "/trader",
      "dest": "/public/trader.html"
    },
    {
      "src": "/trading",
      "dest": "/public/trading.html"
    },
    {
      "src": "/xmr-miner",
      "dest": "/public/xmr-miner.html"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}