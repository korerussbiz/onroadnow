import express from "express";
import fs from "node:fs/promises";
import crypto from "node:crypto";
import cookieParser from "cookie-parser";
import path from "node:path";

const app = express();
app.use(express.json({ limit: "10kb" }));
app.use(cookieParser());

// Block direct access to sensitive paths before static middleware
app.use((req, res, next) => {
  if (req.path.startsWith("/data/") || req.path === "/server.js" || req.path === "/package.json") {
    return res.status(404).end();
  }
  next();
});

// Serve frontend static files from project root
app.use(express.static(process.cwd(), { index: "index.html" }));

const LINKS = path.resolve("data/links.json");
const EVENTS = path.resolve("data/events.csv");
const SUBS = path.resolve("data/subscribers.csv");

async function readLinks() { return JSON.parse(await fs.readFile(LINKS, "utf8")); }
function ipHash(req) {
  const day = new Date().toISOString().slice(0, 10);
  const ip = req.headers["x-forwarded-for"]?.split(",")[0]?.trim() || req.socket.remoteAddress || "";
  return crypto.createHash("sha256").update(ip + day).digest("hex").slice(0, 16);
}

// --- /api/links --- returns only published links, strips internal fields
app.get("/api/links", async (_req, res) => {
  try {
    const data = await readLinks();
    const filtered = {
      owner: data.owner,
      tagline: data.tagline,
      categories: data.categories
        .map(cat => ({
          title: cat.title,
          links: cat.links
            .filter(l => l.published === true)
            .map(({ id, name, url, note, risk }) => ({ id, name, url, note, risk })),
        }))
        .filter(cat => cat.links.length > 0),
    };
    res.json(filtered);
  } catch (e) {
    console.error(e);
    res.status(500).json({ error: "link data unavailable" });
  }
});

// --- /api/event --- funnel events (view/click/signup)
app.post("/api/event", async (req, res) => {
  const { event, linkId, variant, utm } = req.body || {};
  if (!["view", "click", "signup"].includes(event)) return res.status(400).json({ error: "bad event" });
  const row = [
    new Date().toISOString(),
    event,
    (linkId || "").replace(/[",\n]/g, ""),
    (variant || "").replace(/[",\n]/g, ""),
    (utm?.source || "direct").replace(/[",\n]/g, ""),
    (utm?.campaign || "").replace(/[",\n]/g, ""),
    ipHash(req),
  ].join(",") + "\n";
  try { await fs.access(EVENTS); } catch { await fs.writeFile(EVENTS, "ts,event,link_id,variant,source,campaign,ip_hash\n"); }
  await fs.appendFile(EVENTS, row);
  res.json({ ok: true });
});

// --- /api/subscribe --- email capture (double opt-in TODO: wire SMTP)
app.post("/api/subscribe", async (req, res) => {
  const email = String(req.body?.email || "").trim().toLowerCase();
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) return res.status(400).json({ error: "invalid email" });
  const exists = await fs.readFile(SUBS, "utf8").catch(() => "");
  if (exists.split("\n").some(l => l.split(",")[1] === email)) return res.json({ ok: true, already: true });
  await fs.appendFile(SUBS, `${new Date().toISOString()},${email},pending\n`);
  res.json({ ok: true });
});

// --- /api/variant --- A/B assignment via cookie
app.get("/api/variant", (req, res) => {
  let v = req.cookies?.ab;
  if (!v) {
    v = Math.random() < 0.5 ? "A" : "B";
    res.cookie("ab", v, { maxAge: 30 * 24 * 3600 * 1000, sameSite: "lax" });
  }
  res.json({ variant: v });
});

// --- /admin.html --- gated dashboard
app.get("/admin.html", (req, res) => {
  if ((req.query.token || req.headers["x-admin-token"]) !== process.env.ADMIN_TOKEN) {
    return res.status(401).send("unauthorized");
  }
  res.sendFile(path.resolve("_admin.html"));
});

// --- /api/metrics --- aggregated funnel stats
app.get("/api/metrics", async (req, res) => {
  if ((req.query.token || req.headers["x-admin-token"]) !== process.env.ADMIN_TOKEN) {
    return res.status(401).json({ error: "unauthorized" });
  }
  const ev = await fs.readFile(EVENTS, "utf8").catch(() => "");
  const lines = ev.trim().split("\n").slice(1).filter(Boolean);
  const bySource = {}, byVariant = {}, byLink = {};
  for (const line of lines) {
    const [, event, linkId, variant, source] = line.split(",");
    for (const [obj, key] of [[bySource, source], [byVariant, variant], [byLink, linkId]]) {
      if (!key) continue;
      obj[key] = obj[key] || { view: 0, click: 0, signup: 0 };
      obj[key][event] = (obj[key][event] || 0) + 1;
    }
  }
  const subs = (await fs.readFile(SUBS, "utf8").catch(() => "")).trim().split("\n").length - 1;
  res.json({ bySource, byVariant, byLink, subscribers: Math.max(0, subs) });
});

if (process.env.VERCEL !== "1") {
  const PORT = process.env.PORT || 3000;
  app.listen(PORT, "0.0.0.0", () => console.log(`referral-hub on http://localhost:${PORT}`));
}
export default app;

